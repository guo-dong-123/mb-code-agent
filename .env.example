# mb-code-agent 环境变量配置示例
# 复制此文件为 .env 或直接在终端 export 以下变量

# 必填：大模型 API Key
MB_AGENT_API_KEY=sk-your-api-key-here

# 可选：API Base URL（默认通义千问 DashScope 兼容模式）
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 硅基流动: https://api.siliconflow.cn/v1
MB_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：模型名称（默认 qwen3.8-max）
# OpenAI: gpt-4o-mini
# DeepSeek: deepseek-chat
MB_AGENT_MODEL=qwen3.8-max
